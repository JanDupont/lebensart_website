{
    "name": "lebensart_website",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.15.1",
    "engines": {
        "node": "24.18.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json"
    },
    "dependencies": {
        "@mdi/js": "7.4.47",
        "vue": "3.5.40",
        "vue-i18n": "11.4.7",
        "vue-router": "5.2.0",
        "vuetify": "4.1.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.1.1",
        "@vitejs/plugin-vue": "6.0.8",
        "eslint": "10.7.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-vue": "10.10.0",
        "globals": "17.7.0",
        "prettier": "3.9.6",
        "sass": "1.101.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.1.5",
        "vite-plugin-vuetify": "2.1.3",
        "vue-tsc": "3.3.7"
    }
}
